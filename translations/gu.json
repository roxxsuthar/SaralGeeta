  "faq": {
    "heading": {
      "id": "app.container.faq.heading",
      "defaultMessage": "FAQ"
    },
    "subHeading": {
      "id": "app.container.faq.subHeading",
      "defaultMessage": "સરલ ગીતા એપ્લિકેશન વિશે વારંવાર પૂછાતા પ્રશ્નો"
    },
    "q1_question": {
      "id": "app.container.faq.q1_question",
      "defaultMessage": "સરલ ગીતા એપ શું છે?"
    },
    "q1_answer": {
      "id": "app.container.faq.q1_answer",
      "defaultMessage": "સરલ ગીતા એપ એક ડિજિટલ પ્લેટફોર્મ છે જ્યાં જે લોકો ગીતા શીખવા માંગે છે તેઓ તેને સીધા ભગવાન પાસેથી શીખી શકે છે."
    },
    "q2_question": {
      "id": "app.container.faq.q2_question",
      "defaultMessage": "સરલ ગીતા એપમાં શિક્ષક કોણ છે?"
    },
    "q2_answer": {
      "id": "app.container.faq.q2_answer",
      "defaultMessage": "સરલ ગીતા એપમાં ભગવાન સ્વયં ગુરુ છે. આપણી પાસે ભગવાન વિષ્ણુ, ભગવાન ગણેશ અને ભગવાન વેદવ્યાસ છે. તમે આ ત્રણમાંથી કોઈપણ એક પાસેથી ગીતા શીખી શકો છો."
    },
    "q3_question": {
      "id": "app.container.faq.q3_question",
      "defaultMessage": "સરલ ગીતા એપમાં ગીતા શીખવાની પદ્ધતિ શું છે?"
    },
    "q3_answer": {
      "id": "app.container.faq.q3_answer",
      "defaultMessage": "તમારે કોઈપણ એક ભગવાનને તમારા ગુરુ તરીકે પસંદ કરવાનો છે. પસંદ કરવા પર, ગીતાના તમામ 18 અધ્યાય તમારી સમક્ષ હાજર થશે. તમે જે પણ પ્રકરણ શીખવા માંગો છો, તેના તમામ શ્લોક પ્રદર્શિત કરવામાં આવશે. તમે જે શ્લોક શીખવા માંગો છો તેના પર ક્લિક કરો, અને ભગવાન તેનો ધીમે ધીમે પાઠ કરશે. નીચે શ્લોક પણ લખવામાં આવશે. લખેલા શ્લોકને જુઓ અને ભગવાન સાથે તેનો ઉચ્ચાર કરો. જ્યાં સુધી તમે તેનો યોગ્ય રીતે ઉચ્ચાર ન કરી શકો ત્યાં સુધી ભગવાન સાથે સમાન શ્લોકનું પુનરાવર્તન કરો. આ રીતે, તમે એક પછી એક શ્લોકોને યાદ કરી શકો છો."
    },
    "q4_question": {
      "id": "app.container.faq.q4_question",
      "defaultMessage": "શું આપણે સરલ ગીતા એપમાં શ્લોકોનો અર્થ પણ જાણી શકીએ છીએ?"
    },
    "q4_answer": {
      "id": "app.container.faq.q4_answer",
      "defaultMessage": "હા, આપણે તેનો અર્થ પણ જાણી શકીએ છીએ. જ્યારે ભગવાન શ્લોકનો પાઠ કરે છે, ત્યારે બાજુ પર 'i' (માહિતી) બિંદુ દેખાય છે. તેના પર ક્લિક કરવાથી તમને તેના અર્થ સાથે શ્લોક દેખાશે."
    },
    "q5_question": {
      "id": "app.container.faq.q5_question",
      "defaultMessage": "શું સરલ ગીતા એપ માત્ર એક જ ભાષામાં ઉપલબ્ધ છે?"
    },
    "q5_answer": {
      "id": "app.container.faq.q5_answer",
      "defaultMessage": "ના, સરલ ગીતા એપ હિન્દી, અંગ્રેજી, મરાઠી, ગુજરાતી અને અન્ય ભાષાઓ જેવી 10 ભાષાઓમાં ઉપલબ્ધ છે."
    },
    "q6_question": {
      "id": "app.container.faq.q6_question",
      "defaultMessage": "સરલ ગીતા એપમાં આપણે જે યાદ રાખ્યું છે તે કેવી રીતે ચકાસી શકીએ?"
    },
    "q6_answer": {
      "id": "app.container.faq.q6_answer",
      "defaultMessage": "ભગવાન શ્લોકનો પાઠ કરે છે અને શાંત થઈ જાય છે, સ્ક્રીન પર માઇક્રોફોન બટન દેખાય છે. તેના પર ક્લિક કરો, સમગ્ર શ્લોકનો પાઠ કરો, પછી ફરીથી માઈક બટન દબાવો. સ્ક્રીન બતાવશે કે તમે કેટલા ટકા સાચા બોલ્યા. જો તે 80% કે તેથી વધુ હોય, તો તેનો અર્થ એ છે કે તમે તે શ્લોકનો ઉચ્ચાર શીખી લીધો છે અને તમે આગળના શ્લોક પર જઈ શકો છો."
    },
    "q7_question": {
      "id": "app.container.faq.q7_question",
      "defaultMessage": "જ્યારે તમે સરલ ગીતા એપ્લિકેશનમાંથી સંપૂર્ણ પ્રકરણ યાદ કરો છો ત્યારે શું થાય છે?"
    },
    "q7_answer": {
      "id": "app.container.faq.q7_answer",
      "defaultMessage": "જો તમે સરલ ગીતા એપનો ઉપયોગ કરીને ગીતાના કોઈપણ એક પ્રકરણને યાદ રાખો છો, તો તમે તે યાદ કરેલા પ્રકરણ માટે ગીતા એવોર્ડ વિભાગમાં ઈનામ માટે નોંધણી કરાવી શકો છો. પુષ્ટિ પર, અમે તમારા પ્રદાન કરેલા સરનામાં પર ઇનામ કુરિયર કરીશું."
    },
    "q8_question": {
      "id": "app.container.faq.q8_question",
      "defaultMessage": "સરલ ગીતા એપમાં ગીતાના નિયમો શું છે?"
    },
    "q8_answer": {
      "id": "app.container.faq.q8_answer",
      "defaultMessage": "સરલ ગીતા એપમાં દૈનિક જીવન માટે ઉપયોગી 9 નિયમો છે. તે દિવસે તમે જે નિયમનું પાલન કર્યું છે તેના પર ક્લિક કરો અને તેને સબમિટ કરો. આ રીતે, તમારા અનુસરેલા નિયમોનો માસિક સારાંશ તૈયાર કરવામાં આવે છે, જે તમને જણાવે છે કે તમે કયા નિયમોનું પાલન કર્યું છે અને તમે આખા મહિનામાં કયા નિયમો ચૂકી ગયા છો."
    },
    "q9_question": {
      "id": "app.container.faq.q9_question",
      "defaultMessage": "સરલ ગીતા એપમાં ગીતા શિક્ષકની વિશેષતા શું છે?"
    },
    "q9_answer": {
      "id": "app.container.faq.q9_answer",
      "defaultMessage": "જો તમે ગીતા જાણો છો, તો માત્ર એક પ્રકરણ પણ, તમે ગીતા શિક્ષક બનવા માટે ગીતા શિક્ષક સુવિધા દ્વારા નોંધણી કરાવી શકો છો. તમે કેટલા પ્રકરણો કંઠસ્થ કર્યા છે તેનો ઉલ્લેખ કરી શકો છો. તમારી ઈચ્છા હોય ત્યાં અમે તમને ભણાવવાની સંપૂર્ણ વ્યવસ્થા કરીશું, તમારા ભણાવવાનું મહેનતાણું આપીશું અને જો તમને ગીતા શિક્ષક બનવા માટે તાલીમની જરૂર પડશે તો અમે તે પણ આપીશું."
    },
    "q10_question": {
      "id": "app.container.faq.q10_question",
      "defaultMessage": "સરલ ગીતા એપમાં ગીતા અભ્યાસ (અભ્યાસ) શું છે?"
    },
    "q10_answer": {
      "id": "app.container.faq.q10_answer",
      "defaultMessage": "ગીતા અભ્યાસ એ એક વિશેષતા છે જે તમને તમે યાદ કરેલા પ્રકરણોને સુધારવાની મંજૂરી આપે છે. ભગવાન તમારી સમક્ષ હાજર છે, અને તમે ભગવાનને કહો કે તમને કયા પ્રકરણો યાદ છે. પછી ભગવાન તમને તે પ્રકરણોમાંથી તેમની સંખ્યાઓ સાથે શ્લોક પૂછશે, તમને તમારા યાદ કરેલા પ્રકરણોને સુધારવાની મંજૂરી આપશે."
    },
    "q11_question": {
      "id": "app.container.faq.q11_question",
      "defaultMessage": "શું આપણે સરલ ગીતા એપમાં એક જ વારમાં સંપૂર્ણ અધ્યાયનો પાઠ કરી શકીએ?"
    },
    "q11_answer": {
      "id": "app.container.faq.q11_answer",
      "defaultMessage": "હા! જો તમે એકસાથે આખો પ્રકરણ વાંચવા માંગતા હો, તો પ્રકરણ અને શ્લોક ખોલો, પછી સ્ક્રીનની ટોચ પર 'ચાલુ રાખો' બટનને ક્લિક કરો. ભગવાન આખા અધ્યાયનો સતત પાઠ કરશે. તેની બાજુમાં એક સ્પીડ બટન પણ છે, જેથી તમે ઈચ્છો તો ઝડપથી પાઠ કરી શકો છો."
    },
    "q12_question": {
      "id": "app.container.faq.q12_question",
      "defaultMessage": "સરલ ગીતા એપમાં 'ગીતા લખો' સુવિધા શું છે?"
    },
    "q12_answer": {
      "id": "app.container.faq.q12_answer",
      "defaultMessage": "'ગીતા લખો' એ એક ઝુંબેશ છે જ્યાં તમે ગીતા, રામાયણ, ભાગવત જેવા ગ્રંથો હસ્તલેખિત કરી શકો છો અને અન્ય ઘણા ઉપલબ્ધ છે. અમે રજિસ્ટર, અસલ પુસ્તક અને પેન તમારા સરનામા પર કુરિયર કરીએ છીએ. તમે લખવા માંગો છો તે કલમ પસંદ કરો અને તમારા નામ અને સરનામા સાથે સબમિટ કરો. ત્યારબાદ અમે તમને લેખન માટે જરૂરી તમામ સામગ્રી મોકલીશું. તમારે દર 15 દિવસે તમે કેટલા શાસ્ત્રો પૂર્ણ કર્યા છે તેની જાણ કરવાની જરૂર પડશે. સમગ્ર ગ્રંથ પૂર્ણ કર્યા પછી, તમને ચિત્રાત્મક પ્રમાણપત્રથી સન્માનિત કરવામાં આવશે."
    }
  },
