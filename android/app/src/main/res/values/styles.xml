<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Make the app truly full screen -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="BootTheme" parent="Theme.BootSplash">
        <!-- 1. Hide the system splash screen by making the starting window translucent -->
        <item name="android:windowIsTranslucent">true</item>
        
        <!-- 2. Set your full-screen image as the actual window background -->
        <item name="android:windowBackground">@drawable/splash_screen_full</item>

        <!-- 3. Standard BootSplash settings -->
        <item name="bootSplashBackground">@android:color/transparent</item>
        <item name="bootSplashLogo">@android:color/transparent</item>
        <item name="postBootSplashTheme">@style/AppTheme</item>
    </style>
</resources>
