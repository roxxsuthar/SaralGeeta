<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Reverted to standard app theme -->
    </style>

    <style name="BootTheme" parent="Theme.BootSplash">
        <!-- 1. Fix Error: Remove windowIsTranslucent to prevent startup crashes -->

        <!-- 2. Hide the Android 12+ system icon (the "default screen" circle) -->
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>

        <!-- 3. Set the system background to match your color immediately -->
        <item name="windowSplashScreenBackground">@color/bootsplash_background</item>
        <item name="android:windowSplashScreenBackground">@color/bootsplash_background</item>

        <!-- 4. Use your full-screen image as the actual window background -->
        <item name="android:windowBackground">@drawable/splash_screen_full</item>
        
        <!-- 5. React-native-bootsplash settings -->
        <item name="bootSplashBackground">@color/bootsplash_background</item>
        <item name="bootSplashLogo">@android:color/transparent</item>
        <item name="postBootSplashTheme">@style/AppTheme</item>
    </style>
</resources>
